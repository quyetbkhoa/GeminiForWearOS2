<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/layout_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#000000">

        <!-- Top Response Area (~80% screen space): Scrollable Text -->
        <ScrollView
            android:id="@+id/scroll_result"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Minimal Status Indicator -->
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NHẤN ĐỂ NÓI"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="6dp" />

                <!-- Text Content Display Area -->
                <TextView
                    android:id="@+id/tv_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chạm hoặc nhấn giữ micro bên dưới để hỏi..."
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Control Bar: Mic (Sea Blue 48x48dp), Cancel (Red 48x48dp), Version (plain text) -->
        <!-- Flush at bottom edge with 0dp padding/margin to maximize top content area -->
        <LinearLayout
            android:id="@+id/layout_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="0dp"
            android:layout_marginBottom="0dp">

            <!-- 1. Colored Record Button with Pulse Glow Ring (Height matches Cancel button 48dp) -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp">

                <View
                    android:id="@+id/view_mic_pulse_ring"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_watch_mic_pulse_ring"
                    android:alpha="0" />

                <FrameLayout
                    android:id="@+id/btn_ptt_container"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_watch_btn_mic_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Nhấn để nói với Gemini">

                    <ImageView
                        android:id="@+id/iv_mic_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic"
                        android:contentDescription="@null" />
                </FrameLayout>
            </FrameLayout>

            <!-- 2. Red Cancel Button (Crimson Red 48x48dp) -->
            <FrameLayout
                android:id="@+id/btn_cancel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_watch_btn_cancel_red"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Hủy lệnh hiện tại">

                <ImageView
                    android:id="@+id/iv_cancel_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cancel"
                    android:contentDescription="@null" />
            </FrameLayout>

            <!-- 3. App Version: Clean Plain Text (Không đóng khung button) -->
            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.4.3"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

        </LinearLayout>

    </LinearLayout>

    <!-- Blackout Overlay for smooth dimming & exit -->
    <View
        android:id="@+id/view_dim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0"
        android:visibility="gone"
        android:clickable="false" />

</FrameLayout>
