<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#07080A"
    android:paddingLeft="22dp"
    android:paddingRight="22dp"
    android:paddingTop="18dp"
    android:paddingBottom="20dp">

    <!-- Header Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GEMINI ASSISTANT"
        android:textColor="#D4AF37"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:shadowColor="#000000"
        android:shadowDy="2"
        android:shadowRadius="3" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NHẤN GIỮ ĐỂ NÓI"
        android:textColor="#8892B0"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp" />

    <!-- Center Skeuomorphic PTT Button -->
    <FrameLayout
        android:id="@+id/btn_ptt_container"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_ptt_idle"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_mic_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic" />
    </FrameLayout>

    <!-- Response Display Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_result_plate"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Giữ nút nói để đặt câu hỏi. Gemini sẽ trả lời ngắn gọn ngay tại đây!"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>