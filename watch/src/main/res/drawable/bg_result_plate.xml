<?xml version="1.0" encoding="utf-8"?>
<!-- Luxury Chronograph Sapphire Crystal Display Plate -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Recess Groove / Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#000000" />
        </shape>
    </item>
    <!-- Machined Titanium Outer Bevel -->
    <item android:top="1.5dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#3F4758"
                android:centerColor="#262C38"
                android:endColor="#14171E" />
            <stroke android:width="1.2dp" android:color="#5C677D" />
        </shape>
    </item>
    <!-- Inner Dark Sapphire Window -->
    <item android:top="3.5dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0D1017"
                android:centerColor="#131722"
                android:endColor="#181D2A" />
            <stroke android:width="1dp" android:color="#2D3545" />
        </shape>
    </item>
</layer-list>