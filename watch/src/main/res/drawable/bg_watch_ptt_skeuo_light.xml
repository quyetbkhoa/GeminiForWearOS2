<?xml version="1.0" encoding="utf-8"?>
<!-- Skeuomorphism Light PTT: Brushed Chrome Rotary Dial with Antique Bronze Ring -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Metal Glow Halo -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#20D97706" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
    <!-- Outer Beveled Chrome Ring -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#E2E8F0" />
            <stroke android:width="1.5dp" android:color="#94A3B8" />
        </shape>
    </item>
    <!-- Inner Bronze Bezel -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#D97706" />
            <gradient
                android:type="radial"
                android:gradientRadius="24dp"
                android:startColor="#FFFFFF"
                android:centerColor="#E2E8F0"
                android:endColor="#CBD5E1" />
        </shape>
    </item>
</layer-list>
