<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- M3 Outer Teal Accent Ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#20004D40" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
    <!-- M3 Mid Border -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#00382E" />
            <stroke android:width="1.5dp" android:color="#80CBC4" />
        </shape>
    </item>
    <!-- M3 Core -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#004D40" />
        </shape>
    </item>
</layer-list>
