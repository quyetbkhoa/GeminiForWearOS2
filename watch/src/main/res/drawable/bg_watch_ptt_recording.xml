<?xml version="1.0" encoding="utf-8"?>
<!-- Perfectly Symmetrical 1:1 Circular Button (Active Recording State - Glowing Ruby) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Crimson Glow Aura -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#40EF4444" />
        </shape>
    </item>
    <!-- Symmetrical Inner Core -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="35dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#EF4444"
                android:centerColor="#B91C1C"
                android:endColor="#7F1D1D" />
            <stroke android:width="2.5dp" android:color="#FCA5A5" />
        </shape>
    </item>
</layer-list>
