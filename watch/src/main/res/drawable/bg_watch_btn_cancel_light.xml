<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Bezel Ring -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#CBD5E1"
                android:centerColor="#E2E8F0"
                android:endColor="#F1F5F9" />
            <stroke android:width="1.2dp" android:color="#94A3B8" />
        </shape>
    </item>
    <!-- Inner Crimson Tinted Core -->
    <item
        android:left="2.5dp"
        android:top="2.5dp"
        android:right="2.5dp"
        android:bottom="2.5dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="22dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#FEE2E2"
                android:centerColor="#FECACA"
                android:endColor="#FCA5A5" />
            <stroke android:width="1.2dp" android:color="#EF4444" />
        </shape>
    </item>
</layer-list>
