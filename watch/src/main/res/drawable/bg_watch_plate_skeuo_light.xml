<?xml version="1.0" encoding="utf-8"?>
<!-- Skeuomorphism Light: Brushed Stainless Steel Plate with Beveled Rims and Antique Bronze Accents -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Metal Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#3064748B" />
        </shape>
    </item>
    <!-- Brushed Chrome Bevel Rim -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1.5dp"
                android:color="#94A3B8" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Inner Brushed Steel Face -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F8FAFC"
                android:centerColor="#E2E8F0"
                android:endColor="#CBD5E1" />
            <stroke
                android:width="1dp"
                android:color="#D97706" />
            <padding
                android:left="12dp"
                android:top="12dp"
                android:right="12dp"
                android:bottom="12dp" />
        </shape>
    </item>
</layer-list>
