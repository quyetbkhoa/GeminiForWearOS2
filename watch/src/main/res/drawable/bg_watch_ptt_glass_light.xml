<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass Light PTT: Translucent Frosted Crystal Ice Orb -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Ice Blue Glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#2538BDF8" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
    <!-- Middle Glass Frosted Ring -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#40BAE6FD" />
            <stroke android:width="1.5dp" android:color="#9038BDF8" />
        </shape>
    </item>
    <!-- Core Translucent Ice -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#E0F2FE"
                android:centerColor="#7DD3FC"
                android:endColor="#0284C7" />
            <stroke android:width="1dp" android:color="#B0FFFFFF" />
        </shape>
    </item>
</layer-list>
