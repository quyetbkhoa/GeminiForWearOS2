<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass Dark PTT: Luminous Ice Cyan Crystal Orb -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Cyan Glow Halo -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#3038BDF8" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
    <!-- Middle Glass Luminous Ring -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#401E3A8A" />
            <stroke android:width="1.5dp" android:color="#907DD3FC" />
        </shape>
    </item>
    <!-- Core Translucent Ice Sapphire -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#2563EB"
                android:centerColor="#1D4ED8"
                android:endColor="#0F172A" />
            <stroke android:width="1dp" android:color="#80BAE6FD" />
        </shape>
    </item>
</layer-list>
