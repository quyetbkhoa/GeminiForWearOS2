<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_rack_card"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Top info bar: Timestamp + Replay button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_qa_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🕒 05:58:10 - Hôm nay"
            android:textColor="#94A3B8"
            android:textStyle="bold"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_replay_tts"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="🔊 NGHE LẠI"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_emerald"
            android:backgroundTint="@null"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />
    </LinearLayout>

    <!-- Question Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_qa_question"
        android:padding="8dp"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗣️ BẠN HỎI:"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_qa_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nội dung câu hỏi của bạn..."
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Answer Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_qa_answer"
        android:padding="8dp"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖 GEMINI ĐÁP:"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_qa_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nội dung câu trả lời từ Gemini..."
            android:textColor="#ECFDF5"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>
