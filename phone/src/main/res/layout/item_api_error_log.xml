<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_rack_card"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <!-- Header: Status Badge, Device Origin, Timestamp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_error_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 HTTP 403"
            android:textColor="#EF4444"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="#33EF4444" />

        <TextView
            android:id="@+id/tv_error_source_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌚ ĐỒNG HỒ"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:background="#2038BDF8" />

        <TextView
            android:id="@+id/tv_error_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="11:40:55 - 07/09"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:gravity="end" />
    </LinearLayout>

    <!-- Model & Key Info -->
    <TextView
        android:id="@+id/tv_error_model_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mô hình: gemini-3.8-flash | Key: AQ.Ab8...VoMg"
        android:textColor="#CBD5E1"
        android:textSize="10.5sp"
        android:fontFamily="monospace"
        android:layout_marginTop="6dp" />

    <!-- Error Message / Cause -->
    <TextView
        android:id="@+id/tv_error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nguyên nhân: Method doesn't allow unregistered callers."
        android:textColor="#FCA5A5"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <!-- Actionable Solution / Suggestion Box -->
    <LinearLayout
        android:id="@+id/layout_error_suggestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1510B981"
        android:padding="8dp"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tv_error_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👉 Hướng dẫn: Mở app Gemini trên điện thoại, nhập API Key và bấm 'LƯU &amp; ĐỒNG BỘ SANG ĐỒNG HỒ'."
            android:textColor="#6EE7B7"
            android:textSize="10.5sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Raw JSON Toggle & Copy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/btn_toggle_raw_json"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶ Xem chi tiết phản hồi JSON từ Google"
            android:textColor="#A78BFA"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingVertical="4dp" />

        <Button
            android:id="@+id/btn_copy_error_json"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="📋 SAO CHÉP"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_metallic"
            android:backgroundTint="@null"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- Raw JSON Container (Initially Gone) -->
    <HorizontalScrollView
        android:id="@+id/scroll_raw_json"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tv_raw_json"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#E2E8F0"
            android:textSize="9.5sp"
            android:background="#20000000"
            android:padding="6dp"
            android:text="{}" />
    </HorizontalScrollView>

</LinearLayout>
