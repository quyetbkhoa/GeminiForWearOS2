<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8FAFC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gemini Voice Companion"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1E293B" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chọn thiết bị Bluetooth được phép phát giọng nói (TTS) khi đồng hồ hỏi Gemini:"
        android:textSize="13sp"
        android:textColor="#64748B"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DANH SÁCH THIẾT BỊ BLUETOOTH ĐÃ GHÉP NỐI:"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#0F766E"
            android:letterSpacing="0.05" />

        <Button
            android:id="@+id/btn_reload_bluetooth"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🔄 LÀM MỚI"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#0F766E"
            android:backgroundTint="#CCFBF1"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="110dp">

        <!-- List of Bluetooth Devices with Checkboxes -->
        <ListView
            android:id="@+id/lv_bluetooth_devices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:divider="#E2E8F0"
            android:dividerHeight="1dp"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tv_empty_devices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Chưa tải được thiết bị.\nVui lòng bấm '🔄 LÀM MỚI' hoặc bật Bluetooth trên máy."
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:padding="8dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Q&A History Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💬 LỊCH SỬ HỎI ĐÁP TỪ ĐỒNG HỒ:"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:letterSpacing="0.05" />

        <Button
            android:id="@+id/btn_clear_history"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="🗑️ XÓA"
            android:textSize="10sp"
            android:textColor="#EF4444"
            android:backgroundTint="#FEE2E2"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />
    </LinearLayout>

    <!-- Q&A History List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lv_qa_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F8FAFC"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/tv_empty_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Chưa có lượt hỏi đáp nào.\nHãy nhấn giữ nút micro trên đồng hồ để hỏi Gemini!"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:padding="16dp" />
    </FrameLayout>

    <Button
        android:id="@+id/btn_test_tts"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="THỬ PHÁT GIỌNG NÓI (TEST TTS)"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="12sp"
        android:backgroundTint="#0F766E"
        android:layout_marginTop="8dp" />

    <!-- Cập nhật tự động từ GitHub -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EDE9FE"
        android:padding="12dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Phiên bản: v1.0.0"
                android:textColor="#5B21B6"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_repo_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="quyetbkhoa/GeminiForWearOS2"
                android:textColor="#7C3AED"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sẵn sàng kiểm tra bản mới từ GitHub."
            android:textSize="12sp"
            android:textColor="#4C1D95"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp" />

        <ProgressBar
            android:id="@+id/pb_update_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:max="100" />

        <Button
            android:id="@+id/btn_check_update"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="KIỂM TRA &amp; CẬP NHẬT (PHONE + WATCH)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:backgroundTint="#7C3AED"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>