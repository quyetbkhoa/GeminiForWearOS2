<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8FAFC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gemini Voice Companion"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1E293B" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chọn thiết bị Bluetooth được phép phát giọng nói (TTS) khi đồng hồ hỏi Gemini:"
        android:textSize="13sp"
        android:textColor="#64748B"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DANH SÁCH THIẾT BỊ BLUETOOTH ĐÃ GHÉP NỐI:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#0F766E"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp" />

    <!-- List of Bluetooth Devices with Checkboxes -->
    <ListView
        android:id="@+id/lv_bluetooth_devices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:divider="#E2E8F0"
        android:dividerHeight="1dp"
        android:padding="8dp" />

    <TextView
        android:id="@+id/tv_last_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tin nhắn cuối từ đồng hồ: (Chưa có)"
        android:textSize="12sp"
        android:textColor="#475569"
        android:background="#E2E8F0"
        android:padding="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_test_tts"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="THỬ PHÁT GIỌNG NÓI (TEST TTS)"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#0F766E" />

    <!-- Cập nhật tự động từ GitHub -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EDE9FE"
        android:padding="12dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Phiên bản: v1.0.0"
                android:textColor="#5B21B6"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_repo_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="quyetbkhoa/GeminiForWearOS2"
                android:textColor="#7C3AED"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sẵn sàng kiểm tra bản mới từ GitHub."
            android:textSize="12sp"
            android:textColor="#4C1D95"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp" />

        <ProgressBar
            android:id="@+id/pb_update_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:max="100" />

        <Button
            android:id="@+id/btn_check_update"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="KIỂM TRA &amp; CẬP NHẬT (PHONE + WATCH)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:backgroundTint="#7C3AED"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>