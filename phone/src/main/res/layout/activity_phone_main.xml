<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0C0E14"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/layout_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:paddingBottom="50dp">

        <!-- Unified Theme & Color Controller (Sync to both Phone & Watch) -->
        <LinearLayout
            android:id="@+id/card_theme_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rack_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_theme_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 ĐỒNG BỘ GIAO DIỆN (PHONE &amp; WATCH):"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#F59E0B"
                android:letterSpacing="0.04"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_theme_sublabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn trên điện thoại sẽ tự động đổi giao diện cả điện thoại và đồng hồ:"
                android:textSize="10sp"
                android:textColor="#94A3B8"
                android:layout_marginBottom="8dp" />

            <!-- Row 1: Style Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Phong cách thiết kế (Style):"
                android:textSize="10sp"
                android:textColor="#CBD5E1"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btn_theme_skeuo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="📻 SKEUOMORPH"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_gold"
                    android:backgroundTint="@null"
                    android:layout_marginRight="3dp" />

                <Button
                    android:id="@+id/btn_theme_glass"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="🧊 LIQUID GLASS"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_metallic"
                    android:backgroundTint="@null"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp" />

                <Button
                    android:id="@+id/btn_theme_material"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="🎨 MATERIAL 3"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_metallic"
                    android:backgroundTint="@null"
                    android:layout_marginLeft="3dp" />
            </LinearLayout>

            <!-- Row 2: Color Mode Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Chế độ màu (Color Mode):"
                android:textSize="10sp"
                android:textColor="#CBD5E1"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_watch_theme_dark"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="🌙 DARK MODE (TỐI)"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_gold"
                    android:backgroundTint="@null"
                    android:layout_marginRight="4dp" />

                <Button
                    android:id="@+id/btn_watch_theme_light"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="☀️ LIGHT MODE (SÁNG)"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_metallic"
                    android:backgroundTint="@null"
                    android:layout_marginLeft="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Model Selector Card -->
        <LinearLayout
            android:id="@+id/card_model_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rack_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_model_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ CHỌN MÔ HÌNH GEMINI (AI MODEL):"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#F59E0B"
                android:letterSpacing="0.04"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_model_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lựa chọn mô hình AI (tự động đồng bộ không dây sang đồng hồ):"
                android:textSize="10sp"
                android:textColor="#94A3B8"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/rg_gemini_models"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_model_38_flash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⭐ Gemini 3.8 Flash (Khuyên dùng - Mới nhất 2026)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#F59E0B"
                    android:buttonTint="#F59E0B"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/rb_model_37_flash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ Gemini 3.7 Flash (Mạnh mẽ &amp; Suy luận tốt)"
                    android:textSize="11sp"
                    android:textColor="#E2E8F0"
                    android:buttonTint="#F59E0B"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/rb_model_35_flash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🚀 Gemini 3.5 Flash (Tốc độ cao)"
                    android:textSize="11sp"
                    android:textColor="#E2E8F0"
                    android:buttonTint="#F59E0B"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/rb_model_35_flash_lite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Gemini 3.5 Flash-Lite (Siêu tiết kiệm token)"
                    android:textSize="11sp"
                    android:textColor="#E2E8F0"
                    android:buttonTint="#F59E0B"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/rb_model_25_flash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ Gemini 2.5 Flash (Bản chuẩn ổn định)"
                    android:textSize="11sp"
                    android:textColor="#E2E8F0"
                    android:buttonTint="#F59E0B"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/rb_model_31_pro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧠 Gemini 3.1 Pro Preview (Phân tích chuyên sâu)"
                    android:textSize="11sp"
                    android:textColor="#E2E8F0"
                    android:buttonTint="#F59E0B"
                    android:paddingVertical="4dp" />
            </RadioGroup>

            <TextView
                android:id="@+id/tv_model_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Đang dùng: Gemini 3.8 Flash"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#34D399"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Top Console Title Plate -->
        <LinearLayout
            android:id="@+id/card_title_plate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rack_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_main_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GEMINI VOICE COMPANION"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#F59E0B"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/tv_main_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HỆ THỐNG ĐIỀU PHỐI BLUETOOTH TTS &amp; LỊCH SỬ TRUY VẤN"
                android:textSize="11sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Gemini API Key Settings Card -->
        <LinearLayout
            android:id="@+id/card_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rack_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_api_key_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑 CÀI ĐẶT GEMINI API KEY:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#F59E0B"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tv_api_key_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhập khóa API Gemini cá nhân. Khóa sẽ được lưu an toàn trên máy và tự động đồng bộ sang đồng hồ qua Bluetooth."
                android:textSize="11sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/et_gemini_api_key"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="AIzaSy..."
                    android:textColorHint="#475569"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:background="@drawable/bg_input_skeuo"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />

                <Button
                    android:id="@+id/btn_toggle_api_visibility"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:text="👁️"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_metallic"
                    android:backgroundTint="@null"
                    android:layout_marginLeft="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_api_key_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa cấu hình API Key riêng."
                android:textSize="11sp"
                android:textColor="#64748B"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_save_api_key"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="💾 LƯU &amp; ĐỒNG BỘ SANG ĐỒNG HỒ"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_emerald"
                android:backgroundTint="@null" />
        </LinearLayout>

        <!-- Bluetooth Device Selector Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_bluetooth_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎧 THIẾT BỊ BLUETOOTH PHÁT TTS:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#34D399"
                android:letterSpacing="0.04" />

            <Button
                android:id="@+id/btn_reload_bluetooth"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🔄 LÀM MỚI"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_metallic"
                android:backgroundTint="@null"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />
        </LinearLayout>

        <!-- Bluetooth Devices Bezel Rack -->
        <LinearLayout
            android:id="@+id/card_bluetooth_rack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_screen_bezel"
            android:padding="6dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/ll_bluetooth_devices_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_empty_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Chưa tải được thiết bị.\nVui lòng bấm '🔄 LÀM MỚI' hoặc bật Bluetooth trên máy."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:padding="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Q&A History Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_history_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💬 LỊCH SỬ HỎI ĐÁP TỪ ĐỒNG HỒ:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#38BDF8"
                android:letterSpacing="0.04" />

            <Button
                android:id="@+id/btn_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="🗑️ XÓA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_crimson"
                android:backgroundTint="@null"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />
        </LinearLayout>

        <!-- Q&A History Screen Bezel -->
        <LinearLayout
            android:id="@+id/card_history_rack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_screen_bezel"
            android:padding="6dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/ll_qa_history_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_empty_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Chưa có lượt hỏi đáp nào.\nHãy mở đồng hồ, app sẽ tự động lắng nghe bạn nói!"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:padding="16dp" />
        </LinearLayout>

        <!-- Test TTS Push Button -->
        <Button
            android:id="@+id/btn_test_tts"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🔊 THỬ PHÁT GIỌNG NÓI (TEST TTS)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_emerald"
            android:backgroundTint="@null"
            android:layout_marginBottom="12dp" />

        <!-- Cập nhật tự động từ GitHub (Avionics Panel) -->
        <LinearLayout
            android:id="@+id/card_update_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rack_panel"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_app_version"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Phiên bản: v1.0.0"
                    android:textColor="#A78BFA"
                    android:textStyle="bold"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_repo_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="quyetbkhoa/GeminiForWearOS2"
                    android:textColor="#C4B5FD"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_update_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sẵn sàng kiểm tra bản mới từ GitHub."
                android:textSize="11sp"
                android:textColor="#E2E8F0"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <ProgressBar
                android:id="@+id/pb_update_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:visibility="gone"
                android:max="100" />

            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="KIỂM TRA &amp; CẬP NHẬT (PHONE + WATCH)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:background="@drawable/bg_btn_gold"
                android:backgroundTint="@null"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_wifi_update_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ Mẹo: Bật Điểm phát sóng (Hotspot) trên điện thoại cho đồng hồ bắt hoặc cùng Wi-Fi để app tự động ghép nối và truyền APK chỉ trong 2 giây!"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>