<?xml version="1.0" encoding="utf-8"?>
<!-- 3D Beveled Amber / Gold Push Button -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Cast Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#451A03" />
        </shape>
    </item>
    <!-- Raised Beveled Button Face -->
    <item android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F59E0B"
                android:centerColor="#D97706"
                android:endColor="#B45309" />
            <stroke android:width="1dp" android:color="#FDE68A" />
        </shape>
    </item>
</layer-list>
