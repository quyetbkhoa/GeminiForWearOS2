<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted Liquid Glass Button (Gold / Accent) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#45F59E0B"
                android:endColor="#20B45309" />
            <stroke android:width="1dp" android:color="#70FBBF24" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#30F59E0B"
                android:centerColor="#1E2B2414"
                android:endColor="#151C170E" />
            <stroke android:width="1dp" android:color="#50FBBF24" />
        </shape>
    </item>
</selector>
