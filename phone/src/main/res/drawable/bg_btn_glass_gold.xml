<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#B0D97706"
                android:endColor="#D0B45309" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#90FBBF24" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#70D97706"
                android:endColor="#90F59E0B" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#B0FBBF24" />
        </shape>
    </item>
</selector>
