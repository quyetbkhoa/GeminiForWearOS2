<?xml version="1.0" encoding="utf-8"?>
<!-- Authentic Liquid Frosted Glass with Luminous Cyan Rim and Deep Frosted Body -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Diffuse Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#40000000" />
        </shape>
    </item>
    <!-- Frosted Glass Outer Bevel Rim -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1.5dp"
                android:color="#607DD3FC" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Translucent Frosted Glass Core -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40334E78"
                android:centerColor="#2B203254"
                android:endColor="#2015243C" />
            <padding
                android:left="14dp"
                android:top="14dp"
                android:right="14dp"
                android:bottom="14dp" />
        </shape>
    </item>
</layer-list>
