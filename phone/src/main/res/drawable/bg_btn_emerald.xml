<?xml version="1.0" encoding="utf-8"?>
<!-- 3D Beveled Glowing Emerald Push Button -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Cast Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#022C22" />
        </shape>
    </item>
    <!-- Raised Beveled Button Face -->
    <item android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#10B981"
                android:centerColor="#059669"
                android:endColor="#047857" />
            <stroke android:width="1dp" android:color="#34D399" />
        </shape>
    </item>
</layer-list>
