<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#B00284C7"
                android:endColor="#D00369A1" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#9038BDF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#800284C7"
                android:endColor="#A038BDF8" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#C038BDF8" />
        </shape>
    </item>
</selector>
