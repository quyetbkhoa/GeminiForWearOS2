<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted Liquid Glass Button (Primary Cyan/Sky) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#4038BDF8"
                android:endColor="#200284C7" />
            <stroke android:width="1dp" android:color="#7038BDF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#3038BDF8"
                android:centerColor="#1E1E293B"
                android:endColor="#150F172A" />
            <stroke android:width="1dp" android:color="#5038BDF8" />
        </shape>
    </item>
</selector>
