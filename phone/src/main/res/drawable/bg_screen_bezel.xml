<?xml version="1.0" encoding="utf-8"?>
<!-- Debossed Display Bezel Screen Plate -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top inner shadow frame -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#06070A" />
        </shape>
    </item>
    <!-- Screen Face (Slightly lighter dark obsidian glass) -->
    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="#0D0F15" />
            <stroke android:width="1.2dp" android:color="#1A202C" />
        </shape>
    </item>
</layer-list>
