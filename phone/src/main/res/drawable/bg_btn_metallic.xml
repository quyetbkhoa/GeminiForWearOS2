<?xml version="1.0" encoding="utf-8"?>
<!-- 3D Beveled Metallic Push Button -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Cast Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#050608" />
        </shape>
    </item>
    <!-- Raised Beveled Button Face -->
    <item android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#32394A"
                android:centerColor="#222734"
                android:endColor="#161922" />
            <stroke android:width="1dp" android:color="#4B5569" />
        </shape>
    </item>
</layer-list>
