<?xml version="1.0" encoding="utf-8"?>
<!-- True Liquid Glass Frosted Panel -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#25000000" />
        </shape>
    </item>
    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0.5dp"
        android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#25253852"
                android:centerColor="#18152236"
                android:endColor="#100E1726" />
            <stroke
                android:width="1dp"
                android:color="#30E2E8F0" />
            <padding
                android:left="13dp"
                android:top="13dp"
                android:right="13dp"
                android:bottom="13dp" />
        </shape>
    </item>
</layer-list>
