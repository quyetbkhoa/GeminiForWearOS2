<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass Light Card: Frosted Crystal Ice Glass with Refractive Specular Rim -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Soft Ice Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#180284C7" />
        </shape>
    </item>
    <!-- Frosted Glass Outer Refractive Rim -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1.5dp"
                android:color="#807DD3FC" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Translucent Frosted Snow/Ice Core -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#D5FFFFFF"
                android:centerColor="#BAF0F9FF"
                android:endColor="#9CE0F2FE" />
            <padding
                android:left="14dp"
                android:top="14dp"
                android:right="14dp"
                android:bottom="14dp" />
        </shape>
    </item>
</layer-list>
