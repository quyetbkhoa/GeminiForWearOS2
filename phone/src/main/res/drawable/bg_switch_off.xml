<?xml version="1.0" encoding="utf-8"?>
<!-- Skeuomorphic OFF Toggle Switch (Debossed matte dark rocker) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="4dp" />
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#181B22"
        android:centerColor="#222733"
        android:endColor="#2D3445" />
    <stroke android:width="1dp" android:color="#14171F" />
</shape>
