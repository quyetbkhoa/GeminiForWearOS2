<?xml version="1.0" encoding="utf-8"?>
<!-- Skeuomorphic ON Toggle Switch (Glowing Emerald LED) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#064E3B" />
        </shape>
    </item>
    <item android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#34D399"
                android:centerColor="#10B981"
                android:endColor="#059669" />
            <stroke android:width="1dp" android:color="#A7F3D0" />
        </shape>
    </item>
</layer-list>
