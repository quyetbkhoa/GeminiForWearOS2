<?xml version="1.0" encoding="utf-8"?>
<!-- Machined Aluminum Console Rack Panel -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#050608" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#202532"
                android:centerColor="#161922"
                android:endColor="#0F1118" />
            <stroke android:width="1.5dp" android:color="#3A4356" />
        </shape>
    </item>
</layer-list>
