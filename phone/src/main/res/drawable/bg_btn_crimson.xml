<?xml version="1.0" encoding="utf-8"?>
<!-- 3D Beveled Crimson Red Push Button -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Cast Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#450A0A" />
        </shape>
    </item>
    <!-- Raised Beveled Button Face -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#EF4444"
                android:centerColor="#DC2626"
                android:endColor="#991B1B" />
            <stroke android:width="1dp" android:color="#FCA5A5" />
        </shape>
    </item>
</layer-list>
