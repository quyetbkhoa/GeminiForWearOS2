<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#B0DC2626"
                android:endColor="#D0B91C1C" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#90F87171" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#70DC2626"
                android:endColor="#90EF4444" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#B0F87171" />
        </shape>
    </item>
</selector>
