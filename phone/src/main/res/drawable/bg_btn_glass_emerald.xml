<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#B0059669"
                android:endColor="#D0047857" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#9034D399" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#70059669"
                android:endColor="#9010B981" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#B034D399" />
        </shape>
    </item>
</selector>
