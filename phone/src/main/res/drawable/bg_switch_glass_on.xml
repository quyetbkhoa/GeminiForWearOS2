<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted Liquid Glass Switch (ON State) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#4038BDF8"
        android:centerColor="#250284C7"
        android:endColor="#150369A1" />
    <stroke android:width="1dp" android:color="#7038BDF8" />
    <padding
        android:left="10dp"
        android:top="4dp"
        android:right="10dp"
        android:bottom="4dp" />
</shape>
